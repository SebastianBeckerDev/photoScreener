<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PhotoScreener.Desktop" x:Class="PhotoScreener.Desktop.MainWindow"
        Title="LumaPick" Icon="avares://PhotoScreener.Desktop/Assets/lumapick.ico" Width="1440" Height="900" MinWidth="740" MinHeight="480" Background="#111318">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#1C2028" Padding="12,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="9">
          <Image Source="avares://PhotoScreener.Desktop/Assets/lumapick.png" Width="25" Height="25" />
          <TextBlock Text="LumaPick" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="Counts" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BCC5D4" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
    <Border Name="FoldersPanel" Width="260" Background="#171A21" Padding="10">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
        <TextBlock Text="Directories" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,10" />
        <TabStrip Grid.Row="1" Name="DirectoryRole" SelectedIndex="0" HorizontalAlignment="Stretch" ToolTip.Tip="Browse source folders or candidates for the current source folder's export target.">
          <TabStrip.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></TabStrip.ItemsPanel>
          <TabStripItem Content="Source" FontSize="13" Padding="10,5" ToolTip.Tip="Browse original photo directories." /><TabStripItem Content="Export target" FontSize="13" Padding="10,5" ToolTip.Tip="Browse candidates without changing the source folder's export binding." />
        </TabStrip>
        <ComboBox Grid.Row="2" Name="RecentFolders" PlaceholderText="Recent directories · last 10" HorizontalAlignment="Stretch" Margin="0,8" ToolTip.Tip="Choose one of the ten most recently used directories in this mode. Unavailable directories remain listed." />
        <DockPanel Grid.Row="3" Margin="0,0,0,6">
          <Button Name="DirectoryUpButton" DockPanel.Dock="Left" Content="↑" ToolTip.Tip="Browse the parent directory." />
          <TextBlock Name="DirectoryContext" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="#A6B0C0" Margin="7,0,0,0" />
        </DockPanel>
        <TreeView Grid.Row="4" Name="DirectoryTree" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Name="OpenButton" Content="Browse…" ToolTip.Tip="Choose a source folder, or browse a candidate export target. Browsing never creates a directory." />
          <Button Name="RefreshButton" Content="↻" ToolTip.Tip="Retry directory availability and reload the tree. In source mode also rescan current photos and exports." />
        </StackPanel>
        <StackPanel Grid.Row="6" Spacing="6" Margin="0,8,0,0">
          <TextBlock Name="ExportCandidateLabel" IsVisible="False" FontSize="11" TextWrapping="Wrap" Foreground="#A6B0C0" />
          <Button Name="TargetButton" IsVisible="False" Content="Use as export target" HorizontalAlignment="Stretch" ToolTip.Tip="Apply this candidate to the current source folder after its pending work has finished. Browsing alone does not change the target." />
        </StackPanel>
        <Thumb Grid.RowSpan="7" Name="FoldersResizeThumb" Width="4" Margin="0,-10,-10,-10" HorizontalAlignment="Right" Cursor="SizeWestEast" ToolTip.Tip="Drag to resize directory navigation."><Thumb.Template><ControlTemplate><Border Background="#35404C" /></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
    </Border>
    <Button Grid.Column="1" Name="FoldersToggleButton" Content="‹" Width="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch" ToolTip.Tip="Collapse or expand directory navigation." />
    <Border Grid.Column="2" Name="ReviewSurface" Focusable="True" Background="#0A0C10">
      <Grid>
        <local:ZoomImage Name="Preview" Margin="8" />
        <Border Margin="16" Padding="7,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC111318" IsHitTestVisible="False"><TextBlock Name="ZoomStatus" Text="Fit" Foreground="#DCE3EC" /></Border>
        <Border Name="CurrentPhotoBadge" IsVisible="False" Margin="16,50,16,16" Padding="9,6" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="420" Background="#DD111318" IsHitTestVisible="False">
          <StackPanel Spacing="3"><TextBlock Name="CurrentName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Name="CurrentStatus" Foreground="#8FDBB4" FontSize="11" TextWrapping="Wrap" /></StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="16" Spacing="4">
          <Button Name="ZoomOutButton" Content="−" Background="#DD1C2028" Foreground="#F4FFF9" ToolTip.Tip="Zoom out around the center of the view." />
          <Button Name="ZoomInButton" Content="+" Background="#DD1C2028" Foreground="#F4FFF9" ToolTip.Tip="Zoom in around the center of the view. Mouse-wheel zoom follows the pointer." />
          <Button Name="ZoomFitButton" Content="Fit" Background="#DD1C2028" Foreground="#F4FFF9" ToolTip.Tip="Show the complete photo. Click the image for a 100% detail preview, then click again to return to Fit." />
        </StackPanel>
        <Border Name="PreviewPending" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16" Padding="12,10" MaxWidth="380" CornerRadius="8" Background="#EE111318" BorderBrush="#39505A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Name="PendingPreviewTarget" FontSize="14" FontWeight="SemiBold" Foreground="#77EFD3" TextWrapping="Wrap" />
            <TextBlock Name="PendingPreviewShown" FontSize="11" Foreground="#BBC5D4" TextWrapping="Wrap" />
            <TextBlock Name="PendingPreviewError" IsVisible="False" FontSize="11" Foreground="#F2B2A8" TextWrapping="Wrap" MaxHeight="100" />
            <ProgressBar Name="PendingPreviewProgress" Height="2" IsIndeterminate="True" Foreground="#50E5C3" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" IsHitTestVisible="False">
          <StackPanel Name="WelcomeBrand" HorizontalAlignment="Center" Spacing="10">
            <Image Source="avares://PhotoScreener.Desktop/Assets/lumapick.png" Width="104" Height="104" />
            <TextBlock Text="LumaPick" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F4FFF9" />
          </StackPanel>
          <TextBlock Name="PreviewMessage" HorizontalAlignment="Center" Foreground="#A6B0C0" FontSize="18" Text="Open a folder to begin reviewing" />
        </StackPanel>
        <Border Name="WorkPanel" IsVisible="False" Background="#EE1C2028" Width="340" HorizontalAlignment="Right" Padding="12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Export activity" Margin="0,0,0,8" FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Button Name="RetryButton" Content="Retry failed" ToolTip.Tip="Retry failed requests in their captured export targets." />
              <Button Name="CancelButton" Content="Cancel pending" ToolTip.Tip="Cancel unfinished requests. Completed export changes remain on disk." />
            </StackPanel>
            <ListBox Name="WorkList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Button Grid.Column="3" Name="InfoToggleButton" Content="›" Width="24" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch" ToolTip.Tip="Collapse or expand photo information and histogram." />
    <Border Grid.Column="4" Name="InfoPanel" Width="230" Background="#171A21">
      <Grid>
      <ScrollViewer Margin="14,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="7">
          <TextBlock Text="Photo information" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
          <TextBlock Text="Capture time" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="CaptureTimeValue" Text="Unknown" TextWrapping="Wrap" ToolTip.Tip="EXIF capture time. Without an embedded timezone offset this is the camera's local time." />
          <TextBlock Text="Focal length" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="FocalLengthValue" Text="Unknown" />
          <TextBlock Text="Exposure" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="ExposureValue" Text="Unknown" />
          <TextBlock Text="ISO" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="IsoValue" Text="Unknown" />
          <TextBlock Text="Aperture" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="ApertureValue" Text="Unknown" />
          <TextBlock Text="Camera" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="CameraValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="Lens" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="LensValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="GPS position" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="LocationValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="Histogram" FontWeight="SemiBold" Margin="0,12,0,2" />
          <local:HistogramView Name="Histogram" Height="86" />
          <TextBlock Name="HistogramStatus" Text="Histogram unavailable" Foreground="#8B96A8" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Name="InfoNotice" Foreground="#8B96A8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </ScrollViewer>
      <Thumb Name="InfoResizeThumb" Width="4" HorizontalAlignment="Left" Cursor="SizeWestEast" ToolTip.Tip="Drag to resize photo information."><Thumb.Template><ControlTemplate><Border Background="#35404C" /></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
    </Border>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto">
      <Button Name="StripToggleButton" Content="⌄" Height="22" Padding="0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" ToolTip.Tip="Collapse or expand thumbnails. Directory links and the filter remain visible." />
      <ListBox Grid.Row="1" Name="Filmstrip" Height="145" Background="#171A21" SelectionMode="Single" AutoScrollToSelectedItem="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Width="132" Spacing="3"><local:ThumbnailView Width="128" Height="88" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8FDBB4" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" Name="StripFooter" ColumnDefinitions="*,Auto,Auto" Margin="8,5" Background="#171A21">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,*">
            <Button Name="SourceLink" Content="Source: —" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="11" Padding="6,3" Margin="0,0,3,0" ToolTip.Tip="Open the current source directory in Explorer or Finder." />
            <Button Grid.Column="1" Name="ExportLink" Content="Export: —" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="11" Padding="6,3" ToolTip.Tip="Open the designated export directory in Explorer or Finder. A default export is created only when picking a photo." />
          </Grid>
          <TextBlock Name="FolderStatus" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8B96A8" />
        </StackPanel>
        <ComboBox Grid.Column="1" Name="FilterBox" Width="112" SelectedIndex="0" VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="Show all photos, picked photos, or unpicked photos in the current folder."><ComboBoxItem Content="All" /><ComboBoxItem Content="Picked" /><ComboBoxItem Content="Unpicked" /></ComboBox>
        <Button Grid.Column="2" Name="ActivityButton" Content="No pending changes" VerticalAlignment="Center" ToolTip.Tip="Show pending and failed export changes with retry and cancellation actions." />
      </Grid>
    </Grid>
  </Grid>
</Window>
