<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PhotoScreener.Desktop" x:Class="PhotoScreener.Desktop.MainWindow"
        Title="LumaPick" Icon="avares://PhotoScreener.Desktop/Assets/lumapick.ico" Width="1440" Height="900" MinWidth="740" MinHeight="480" Background="#111318">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Background="#1C2028" Padding="12,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Button Name="OpenButton" Content="Open folder" ToolTip.Tip="Choose original JPEG or PNG photos to review. A same-stem NEF in the JPEG's folder is copied with its selection." />
          <Button Name="FoldersButton" Content="Folders" ToolTip.Tip="Show or hide the folder list to navigate within the current project." />
          <Button Name="TargetButton" Content="Export target" ToolTip.Tip="Choose where this folder's picked photos are copied. Your choice stays with this folder for the session. Folders using the same target share a pick when the original filenames and verified bytes are identical; Space then updates that shared pick." />
          <Button Name="RefreshButton" Content="Refresh" ToolTip.Tip="Rescan the current source and export folders to check for added, changed or removed photos." />
          <ComboBox Name="FilterBox" Width="120" SelectedIndex="0" ToolTip.Tip="Show all photos, only picked photos, or only unpicked photos in the current folder."><ComboBoxItem Content="All" /><ComboBoxItem Content="Picked" /><ComboBoxItem Content="Unpicked" /></ComboBox>
          <Button Name="ProjectPickedButton" Content="Project picks" ToolTip.Tip="Show picked photos across the current project, using each folder's own export target. Results appear as folders are scanned." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Name="InfoButton" Content="Info" ToolTip.Tip="Show or hide capture time, focal length, exposure, ISO, the preview histogram and GPS information stored in the current photo." />
          <Button Name="ZoomFitButton" Content="Fit" ToolTip.Tip="Reset zoom and show the complete photo. You can also double-click the photo. Use the mouse wheel to zoom around the pointer and drag to move a zoomed photo." />
          <Button Name="StripButton" Content="Strip" ToolTip.Tip="Show or hide the thumbnail strip to give the preview more space." />
          <Button Name="WorkButton" Content="Work" ToolTip.Tip="Show or hide pending and failed pick or unpick changes. Select an entry to review that photo." />
          <Button Name="RetryButton" Content="Retry" ToolTip.Tip="Retry the current export change, including a JPEG's NEF companion. Retry on a picked JPEG can add its missing NEF. Ambiguous old exports require an owner choice first." />
          <Button Name="CancelButton" Content="Cancel pending" ToolTip.Tip="Cancel unfinished pick and unpick requests. Changes already completed on disk remain in place; original photos are preserved." />
        </StackPanel>
        <TextBlock Name="Counts" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BCC5D4" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
    <Border Name="FoldersPanel" IsVisible="False" Width="220" Background="#171A21" Padding="8">
      <DockPanel><TextBlock DockPanel.Dock="Top" Text="Project folders" FontWeight="SemiBold" Margin="4,4,4,8" /><ListBox Name="FolderList"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
    </Border>
    <Border Grid.Column="1" Name="ReviewSurface" Focusable="True" Background="#0A0C10">
      <Grid>
        <local:ZoomImage Name="Preview" Margin="8" />
        <Border Margin="16" Padding="7,4" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC111318" IsHitTestVisible="False"><TextBlock Name="ZoomStatus" Text="Fit" Foreground="#DCE3EC" /></Border>
        <Border Name="PreviewPending" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="16" Padding="12,10" MaxWidth="380" CornerRadius="8" Background="#EE111318" BorderBrush="#39505A" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Name="PendingPreviewTarget" FontSize="14" FontWeight="SemiBold" Foreground="#77EFD3" TextWrapping="Wrap" />
            <TextBlock Name="PendingPreviewShown" FontSize="11" Foreground="#BBC5D4" TextWrapping="Wrap" />
            <TextBlock Name="PendingPreviewError" IsVisible="False" FontSize="11" Foreground="#F2B2A8" TextWrapping="Wrap" MaxHeight="100" />
            <ProgressBar Name="PendingPreviewProgress" Height="2" IsIndeterminate="True" Foreground="#50E5C3" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" IsHitTestVisible="False">
          <StackPanel Name="WelcomeBrand" HorizontalAlignment="Center" Spacing="10">
            <Image Source="avares://PhotoScreener.Desktop/Assets/lumapick.png" Width="104" Height="104" />
            <TextBlock Text="LumaPick" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F4FFF9" />
          </StackPanel>
          <TextBlock Name="PreviewMessage" HorizontalAlignment="Center" Foreground="#A6B0C0" FontSize="18" Text="Open a folder to begin reviewing" />
        </StackPanel>
        <Border Name="WorkPanel" IsVisible="False" Background="#EE1C2028" Width="340" HorizontalAlignment="Right" Padding="12">
          <DockPanel><TextBlock DockPanel.Dock="Top" Text="Pending and failed changes" Margin="0,0,0,8" FontWeight="SemiBold" /><ListBox Name="WorkList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Column="2" Name="InfoPanel" Width="230" Background="#171A21" Padding="14,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="7">
          <TextBlock Text="Photo information" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
          <TextBlock Text="Capture time" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="CaptureTimeValue" Text="Unknown" TextWrapping="Wrap" ToolTip.Tip="EXIF capture time. Without an embedded timezone offset this is the camera's local time." />
          <TextBlock Text="Focal length" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="FocalLengthValue" Text="Unknown" />
          <TextBlock Text="Exposure" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="ExposureValue" Text="Unknown" />
          <TextBlock Text="ISO" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="IsoValue" Text="Unknown" />
          <TextBlock Text="Aperture" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="ApertureValue" Text="Unknown" />
          <TextBlock Text="Camera" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="CameraValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="Lens" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="LensValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="GPS position" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="LocationValue" Text="Unknown" TextWrapping="Wrap" />
          <TextBlock Text="Histogram" FontWeight="SemiBold" Margin="0,12,0,2" />
          <local:HistogramView Name="Histogram" Height="86" />
          <TextBlock Name="HistogramStatus" Text="Histogram unavailable" Foreground="#8B96A8" FontSize="10" TextWrapping="Wrap" />
          <TextBlock Name="InfoNotice" Foreground="#8B96A8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    </Grid>
    <Border Grid.Row="2" Background="#1C2028" Padding="12,7">
      <DockPanel><TextBlock Name="CurrentStatus" DockPanel.Dock="Right" Foreground="#8FDBB4" ToolTip.Tip="JPEG/PNG selection and pending export status. Space also copies or removes verified current NEF companions of a JPEG. Shared picks update all associated folders." /><TextBlock Name="CurrentName" FontWeight="SemiBold" /></DockPanel>
    </Border>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto">
      <ListBox Name="Filmstrip" Height="145" Background="#171A21" SelectionMode="Single" AutoScrollToSelectedItem="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Width="132" Spacing="3"><local:ThumbnailView Width="128" Height="88" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" /><TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8FDBB4" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Row="1" Margin="12,4"><TextBlock DockPanel.Dock="Right" Text="← → Navigate · Space Pick / unpick · Wheel Zoom · Drag Move · Double-click Fit" Foreground="#8B96A8" FontSize="11" /><TextBlock Name="FolderStatus" TextTrimming="CharacterEllipsis" /></DockPanel>
    </Grid>
  </Grid>
</Window>
